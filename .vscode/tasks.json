{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Vite Dev Server",
        "type": "shell",
        "command": "npm run dev",
        "isBackground": true,  // Run this task in the background
        "problemMatcher": [
          {
            "owner": "vite",
            "pattern": [
              {
                "regexp": ".*",
                "file": 1,
                "location": 2,
                "message": 3
              }
            ],
            "background": {
              "activeOnStart": true,
              "beginsPattern": "ready in",
              "endsPattern": "built in"
            }
          }
        ]
      }
    ]
  }
  